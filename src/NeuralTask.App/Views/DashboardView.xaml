<UserControl x:Class="NeuralTask.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SYSTEM TELEMETRY"
                               FontSize="20"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="HARDWARE ENGINE SENSORS // ROLLING BUFFER"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Pill Badge -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource BrushAccentPrimary}"
                                 Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource ColorAccentPrimary}" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="KERNEL LINK: ACTIVE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Four Key Hardware Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="18.4%"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="16 Cores // 3.8 GHz"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4" Value="18.4" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="MEMORY (WORKING SET)"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="14.2 GB"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="44.3% of 32.0 GB"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4" Value="44.3" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Grid.Column="4"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="DISK I/O RATE"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="8.2 MB/s"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="R: 6.1 MB/s | W: 2.1 MB/s"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4" Value="25" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Network Card -->
                <Border Grid.Column="6"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="NETWORK THROUGHPUT"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="340 KB/s"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="In: 290 KB/s | Out: 50 KB/s"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4" Value="12" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Real-Time Telemetry Graph Placeholder Panel -->
            <Border Grid.Row="2"
                    Margin="0,0,0,24"
                    Background="{DynamicResource BrushPanelSurface}"
                    BorderBrush="{DynamicResource BrushAccentPrimary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE TELEMETRY STREAM // CPU &amp; MEMORY WAVEFORM"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccentPrimary}" Margin="0,0,6,0" />
                            <TextBlock Text="CPU" FontSize="11" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccentSecondary}" Margin="0,0,6,0" />
                            <TextBlock Text="RAM" FontSize="11" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Stylized Holographic Waveform Mockup -->
                    <Grid Grid.Row="1">
                        <!-- Horizontal Grid Lines -->
                        <Line X1="0" Y1="30" X2="1000" Y2="30" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />
                        <Line X1="0" Y1="80" X2="1000" Y2="80" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />
                        <Line X1="0" Y1="130" X2="1000" Y2="130" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />

                        <!-- CPU Waveform (Cyan Glow) -->
                        <Polyline Points="0,150 50,140 100,120 150,135 200,90 250,95 300,110 350,60 400,75 450,115 500,80 550,85 600,70 650,90 700,50 750,70 800,65"
                                  Stroke="{DynamicResource BrushAccentPrimary}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round">
                            <Polyline.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource ColorAccentPrimary}" Opacity="0.7" />
                            </Polyline.Effect>
                        </Polyline>

                        <!-- RAM Waveform (Violet Glow) -->
                        <Polyline Points="0,110 50,112 100,110 150,108 200,105 250,105 300,104 350,102 400,100 450,100 500,98 550,97 600,97 650,95 700,95 750,94 800,94"
                                  Stroke="{DynamicResource BrushAccentSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Opacity="0.85">
                            <Polyline.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource ColorAccentSecondary}" Opacity="0.5" />
                            </Polyline.Effect>
                        </Polyline>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Top Offenders Cards (PRD §9) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top CPU Processes Card -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="TOP OFFENDERS // PROCESSOR"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,12" />

                        <!-- Row 1 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="chrome.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 26732 // 48 Threads" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="4.20%" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Antigravity.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 3684 // 72 Threads" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="3.80%" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="explorer.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 15560 // 36 Threads" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="1.50%" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Top Memory Processes Card -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="TOP OFFENDERS // WORKING SET"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,12" />

                        <!-- Row 1 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="chrome.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 26732 // GPU Process" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="1,840 MB" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 2 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Memory Compression" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 4284 // Kernel Worker" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="820 MB" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Row 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Docker Desktop.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="PID 11204 // Container Host" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="650 MB" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
