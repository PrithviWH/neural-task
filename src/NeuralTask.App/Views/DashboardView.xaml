<UserControl x:Class="NeuralTask.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SYSTEM TELEMETRY"
                               FontSize="20"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="{Binding CpuCoresDisplay, FallbackValue='HARDWARE ENGINE SENSORS // ROLLING BUFFER'}"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Status Pill Badge -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource BrushAccentPrimary}"
                                 Margin="0,0,8,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource ColorAccentPrimary}" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusPillText, FallbackValue='KERNEL LINK: ACTIVE'}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Four Key Hardware Metric Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CPU LOAD"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding CpuDisplay, FallbackValue='0.0%'}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="Genuine System Load"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4"
                                     Value="{Binding CpuPercent, Mode=OneWay, FallbackValue=0}" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="MEMORY (PHYSICAL)"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding RamDisplay, FallbackValue='0.0 GB'}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="{Binding RamDetailDisplay, FallbackValue='Used of Total'}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4"
                                     Value="{Binding RamPercent, Mode=OneWay, FallbackValue=0}" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Disk / Process I/O Card -->
                <Border Grid.Column="4"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PROCESS I/O RATE"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding DiskIoDisplay, FallbackValue='0.0 KB/s'}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="{Binding DiskIoDetailDisplay, FallbackValue='Process Read+Write'}"
                                   FontSize="10"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4"
                                     Value="{Binding DiskIoProgress, Mode=OneWay, FallbackValue=0}" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Network Card -->
                <Border Grid.Column="6"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="SYSTEM NETWORK"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding NetworkDisplay, FallbackValue='0.0 KB/s'}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,4,0,2" />
                        <TextBlock Text="{Binding NetworkDetailDisplay, FallbackValue='IPv4 Interface Traffic'}"
                                   FontSize="10"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                        <ProgressBar Margin="0,10,0,0" Height="4"
                                     Value="{Binding NetworkProgress, Mode=OneWay, FallbackValue=0}" Maximum="100"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushBackgroundBase}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Real-Time Telemetry Graph Panel -->
            <Border Grid.Row="2"
                    Margin="0,0,0,24"
                    Background="{DynamicResource BrushPanelSurface}"
                    BorderBrush="{DynamicResource BrushAccentPrimary}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="LIVE TELEMETRY STREAM // 60s ROLLING WINDOW"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccentPrimary}" Margin="0,0,6,0" />
                            <TextBlock Text="CPU %" FontSize="11" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,16,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccentSecondary}" Margin="0,0,6,0" />
                            <TextBlock Text="RAM %" FontSize="11" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <!-- Real-Time Bound Holographic Waveforms -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <!-- Horizontal Grid Lines -->
                        <Line X1="0" Y1="30" X2="1000" Y2="30" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />
                        <Line X1="0" Y1="75" X2="1000" Y2="75" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />
                        <Line X1="0" Y1="120" X2="1000" Y2="120" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="0.5" StrokeDashArray="4 4" Opacity="0.25" />

                        <!-- CPU Waveform (Cyan Glow) -->
                        <Polyline Points="{Binding CpuWaveformPoints}"
                                  Stroke="{DynamicResource BrushAccentPrimary}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round">
                            <Polyline.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{DynamicResource ColorAccentPrimary}" Opacity="0.7" />
                            </Polyline.Effect>
                        </Polyline>

                        <!-- RAM Waveform (Violet Glow) -->
                        <Polyline Points="{Binding RamWaveformPoints}"
                                  Stroke="{DynamicResource BrushAccentSecondary}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  Opacity="0.85">
                            <Polyline.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource ColorAccentSecondary}" Opacity="0.5" />
                            </Polyline.Effect>
                        </Polyline>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Top Offenders Cards (PRD §9) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top CPU Processes Card -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="TOP OFFENDERS // PROCESSOR"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding TopCpuProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, FallbackValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Subtext, FallbackValue='PID —'}" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueDisplay, FallbackValue='0.0%'}" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Top Memory Processes Card -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="TOP OFFENDERS // WORKING SET"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding TopRamProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name, FallbackValue='—'}" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="{Binding Subtext, FallbackValue='PID —'}" FontSize="10" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueDisplay, FallbackValue='0 MB'}" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
