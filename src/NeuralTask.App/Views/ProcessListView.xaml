<UserControl x:Class="NeuralTask.App.Views.ProcessListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Quick Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PROCESS MATRIX"
                           FontSize="20"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="ACTIVE TASK TREE // RUNNING THREAD CLUSTERS"
                           FontSize="11"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Column Picker Stub Button -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconColumnsGeometry}"
                              Stroke="{DynamicResource BrushAccentPrimary}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="COLUMNS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Kill-Tree Action Stub Button -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentSecondary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconKillGeometry}"
                              Stroke="{DynamicResource BrushAccentSecondary}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="TERMINATE TREE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentSecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Search & Filter Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushPanelSurface}"
                BorderBrush="{DynamicResource BrushAccentPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{StaticResource IconSearchGeometry}"
                      Stroke="{DynamicResource BrushTextSecondary}"
                      StrokeThickness="1.5"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center" />

                <TextBox Grid.Column="1"
                         Text="Search by Process Name or PID (Fuzzy Match)..."
                         FontSize="12"
                         FontFamily="{DynamicResource FontFamilyNumeric}"
                         Foreground="{DynamicResource BrushTextSecondary}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="ACTIVE: 312 PROCESSES"
                           FontSize="10"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Process Table Structure (PRD §5.2 No-Clutter Hierarchy) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushPanelSurface}"
                BorderBrush="{DynamicResource BrushAccentPrimary}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Header Row -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushBackgroundBase}"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PROCESS NAME" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="PID" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="CPU %" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="RAM" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="DISK I/O" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="NETWORK" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Table Rows (Fake Static Data) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Row 1: Antigravity.exe -->
                        <Border Padding="20,12" BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="0,0,0,0.5" Opacity="0.95">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Antigravity.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" />
                                    <Border Background="{DynamicResource BrushBackgroundBase}" BorderBrush="{DynamicResource BrushAccentPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="8,0,0,0">
                                        <TextBlock Text="CORE" FontSize="9" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="3684" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="3.80%" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="412.2 MB" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="7.88 MB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="0.0 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 2: chrome.exe -->
                        <Border Padding="20,12" BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="0,0,0,0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="chrome.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="26732" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="4.20%" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="589.0 MB" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="1.21 MB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="18.2 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 3: Code.exe -->
                        <Border Padding="20,12" BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="0,0,0,0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Code.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="19420" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="0.95%" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="278.4 MB" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="240.5 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="4.1 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 4: explorer.exe -->
                        <Border Padding="20,12" BorderBrush="{DynamicResource BrushTextSecondary}" BorderThickness="0,0,0,0.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="explorer.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="15560" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="0.75%" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="486.5 MB" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="877.3 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="36.7 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Row 5: MsMpEng.exe -->
                        <Border Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MsMpEng.exe" FontSize="13" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="5796" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="0.65%" FontSize="12" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="396.7 MB" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="503.7 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="69.7 KB/s" FontSize="12" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. Footer Status -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="SHOWING 5 OF 312 PROCESSES // VIRTUALIZED RENDERING READY"
                       FontSize="10"
                       FontFamily="{DynamicResource FontFamilyNumeric}"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </Grid>
    </Grid>
</UserControl>
