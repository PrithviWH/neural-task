<UserControl x:Class="NeuralTask.App.Views.ProcessListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProcessListViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PROCESS MATRIX"
                           FontSize="20"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="ACTIVE TASK TREE // LIVE WIN32 KERNEL BUFFER"
                           FontSize="11"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Re-Scan Heuristics Button (PRD §8.4 / §9) -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentWarning}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        ToolTip="Trigger Local Heuristic Audit Re-Scan (Not An Antivirus)"
                        MouseDown="OnReScanClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScanGeometry}"
                              Stroke="{DynamicResource BrushAccentWarning}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="RE-SCAN HEURISTICS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentWarning}" />
                    </StackPanel>
                </Border>

                <!-- Copy Process Telemetry Info Button (PRD §6.2) -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        ToolTip="Copy Structured Process Telemetry Report (Ctrl+C)"
                        MouseDown="OnCopyInfoClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCopyGeometry}"
                              Stroke="{DynamicResource BrushAccentPrimary}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="COPY INFO"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Kill Single Process Button -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentPrimary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        ToolTip="Terminate Selected Process"
                        MouseDown="OnKillClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   Margin="0,0,6,0" />
                        <TextBlock Text="KILL PROCESS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}" />
                    </StackPanel>
                </Border>

                <!-- Terminate Tree Button -->
                <Border Background="{DynamicResource BrushPanelSurface}"
                        BorderBrush="{DynamicResource BrushAccentSecondary}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Cursor="Hand"
                        ToolTip="Kill Entire Process Tree"
                        MouseDown="OnTerminateTreeClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconKillGeometry}"
                              Stroke="{DynamicResource BrushAccentSecondary}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Margin="0,0,6,0" />
                        <TextBlock Text="TERMINATE TREE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentSecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Search & Filter Bar + Inline Status Banner -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <!-- Inline Status Banner (Alert Notification) -->
            <Border Visibility="{Binding IsStatusBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource BrushBackgroundBase}"
                    BorderBrush="{DynamicResource BrushWarning}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusBannerMessage}"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Foreground="{DynamicResource BrushTextSecondary}"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            Cursor="Hand"
                            Click="OnDismissBannerClick"
                            Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- Search Bar -->
            <Border Background="{DynamicResource BrushPanelSurface}"
                    BorderBrush="{DynamicResource BrushPanelBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource IconSearchGeometry}"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             FontFamily="{DynamicResource FontFamilyNumeric}"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             CaretBrush="{DynamicResource BrushAccentPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ProcessCountDisplay}"
                               FontSize="10"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- PRD §8.4 Local Heuristics Disclaimer & Anomaly Counter -->
            <Border Background="{DynamicResource BrushBackgroundBase}"
                    BorderBrush="{DynamicResource BrushAccentWarning}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,5"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="LOCAL HEURISTIC TRIAGE // FLAGS ARE ANOMALY SIGNALS, EXPLICITLY NOT AN ANTIVIRUS OR MALWARE SCANNER (PRD §8.4)"
                               FontSize="10"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushAccentWarning}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FlaggedCountDisplay}"
                               FontSize="10"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushAccentPrimary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- 3. Process Table Structure -->
        <Border Grid.Row="2"
                Background="{DynamicResource BrushPanelSurface}"
                BorderBrush="{DynamicResource BrushPanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Interactive Sortable Column Header Row -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BrushBackgroundBase}"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource BrushTableBorder}"
                        BorderThickness="0,0,0,1"
                        Padding="20,0,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Header: Process Name -->
                        <Button Grid.Column="0"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Cursor="Hand" Click="OnHeaderNameClick">
                            <TextBlock Text="PROCESS NAME" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Button>

                        <!-- Header: PID -->
                        <Button Grid.Column="1"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" Click="OnHeaderPidClick">
                            <TextBlock Text="PID" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Button>

                        <!-- Header: CPU % -->
                        <Button Grid.Column="2"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" Click="OnHeaderCpuClick">
                            <TextBlock Text="CPU %" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Button>

                        <!-- Header: RAM -->
                        <Button Grid.Column="3"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" Click="OnHeaderRamClick">
                            <TextBlock Text="RAM" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Button>

                        <!-- Header: Process I/O Rate -->
                        <Button Grid.Column="4"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" Click="OnHeaderIoClick"
                                ToolTip="Process File / Disk Transfer Rate (Read + Write)">
                            <TextBlock Text="PROCESS I/O" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontFamilyNumeric}" Foreground="{DynamicResource BrushTextSecondary}" />
                        </Button>

                        <!-- Header: Network (N/A) -->
                        <TextBlock Grid.Column="5"
                                   Text="NETWORK"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   ToolTip="Per-process socket traffic requires kernel ETW; system-wide throughput is displayed on Dashboard." />
                    </Grid>
                </Border>

                <!-- High-Performance Virtualized Process ListView -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding FilteredProcesses}"
                          SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Single">
                    <ListView.InputBindings>
                        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyProcessInfoCommand}" />
                        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyProcessInfoCommand}" />
                    </ListView.InputBindings>
                    <ListView.ContextMenu>
                        <ContextMenu Background="{DynamicResource BrushBackgroundBase}"
                                     BorderBrush="{DynamicResource BrushAccentPrimary}"
                                     BorderThickness="1">
                            <MenuItem Header="Copy Process Info"
                                      InputGestureText="Ctrl+C"
                                      Foreground="{DynamicResource BrushAccentPrimary}"
                                      Click="OnContextMenuCopyInfoClick" />
                            <Separator Background="{DynamicResource BrushTextSecondary}" Opacity="0.3" Margin="0,4" />
                            <MenuItem Header="Kill Process"
                                      Foreground="{DynamicResource BrushTextPrimary}"
                                      Click="OnContextMenuKillClick" />
                            <MenuItem Header="Kill Process Tree (Topology)"
                                      Foreground="{DynamicResource BrushAccentSecondary}"
                                      Click="OnContextMenuKillTreeClick" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BrushTableBorder}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="20,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushTableHover}" />
                                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.95" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushTableSelected}" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2,0,0,0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProcessItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <!-- Process Name & Heuristic Flag Badge & Denied Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="{DynamicResource FontFamilyUI}"
                                               Foreground="{DynamicResource BrushTextPrimary}" />

                                    <!-- Subtle Glowing Heuristic Flag Badge (PRD §6.2) -->
                                    <Border Background="{DynamicResource BrushBackgroundBase}"
                                            BorderBrush="{Binding FlagBadgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,1.5"
                                            Margin="8,0,0,0"
                                            Cursor="Help"
                                            ToolTipService.InitialShowDelay="50"
                                            ToolTipService.ShowDuration="20000"
                                            Visibility="{Binding HasFlags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.ToolTip>
                                            <ToolTip Background="{DynamicResource BrushBackgroundBase}"
                                                     BorderBrush="{DynamicResource BrushAccentWarning}"
                                                     BorderThickness="1">
                                                <StackPanel Margin="6,4">
                                                    <TextBlock Text="LOCAL HEURISTIC TRIAGE (NOT MALWARE DETECTION)"
                                                               FontWeight="Bold" FontSize="10"
                                                               FontFamily="{DynamicResource FontFamilyNumeric}"
                                                               Foreground="{DynamicResource BrushAccentWarning}"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding FlagTooltip}"
                                                               FontSize="11" FontFamily="{DynamicResource FontFamilyUI}"
                                                               Foreground="{DynamicResource BrushTextPrimary}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="{DynamicResource ColorAccentWarning}" Opacity="0.6" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding FlagBadgeText}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                                   Foreground="{Binding FlagBadgeBrush}" />
                                    </Border>

                                    <!-- Protected System Process Badge -->
                                    <Border Background="{DynamicResource BrushBackgroundBase}"
                                            BorderBrush="{DynamicResource BrushWarning}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="8,0,0,0"
                                            ToolTip="Protected System Process (Access Denied)"
                                            Visibility="{Binding IsAccessDenied, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="PROTECTED"
                                                   FontSize="9"
                                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                                   Foreground="{DynamicResource BrushWarning}" />
                                    </Border>
                                </StackPanel>

                                <!-- PID -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Pid}"
                                           FontSize="12"
                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- CPU % -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CpuDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                           Foreground="{DynamicResource BrushAccentPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- RAM -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding RamDisplay}"
                                           FontSize="12"
                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Process I/O Rate -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding IoDisplay}"
                                           FontSize="12"
                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Network -->
                                <TextBlock Grid.Column="5"
                                           Text="{Binding NetworkDisplay}"
                                           FontSize="12"
                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Overlay Scanner Sweep Beam (PRD §9) -->
                <Canvas Grid.Row="1" x:Name="ScannerSweepCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="ScannerBeam"
                               Height="3"
                               Width="1200"
                               Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="{DynamicResource ColorAccentPrimary}" Offset="0.5" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="{DynamicResource ColorAccentPrimary}" Opacity="0.9" />
                        </Rectangle.Effect>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScannerTransform" X="0" Y="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>
        </Border>

        <!-- 4. Footer Status -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding ProcessCountDisplay}"
                       FontSize="10"
                       FontFamily="{DynamicResource FontFamilyNumeric}"
                       Foreground="{DynamicResource BrushTextSecondary}" />
        </Grid>
    </Grid>
</UserControl>
