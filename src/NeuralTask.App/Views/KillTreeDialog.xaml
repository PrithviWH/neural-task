<Window x:Class="NeuralTask.App.Views.KillTreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirm process tree termination"
        Height="540" Width="680"
        MinHeight="460" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BrushSurface}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Background="{DynamicResource BrushSurface}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Clean Icon & Drag Handle -->
            <Grid Grid.Row="0" Margin="0,0,0,16" x:Name="DialogHeaderBar" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushAccentWarning}" Margin="0,0,10,0">
                            <TextBlock Text="!" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushButtonTextOnAccent}" />
                        </Border>
                        <TextBlock Text="Confirm process tree termination"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="Verified descendant relationships • Start-time checked"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="30,3,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        FontSize="13"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="28" Height="28"
                        Cursor="Hand"
                        IsCancel="True"
                        AutomationProperties.Name="Close dialog"
                        Click="OnCancelClick" />
            </Grid>

            <!-- 2. Warning Description Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <TextBlock x:Name="TextWarningSummary"
                           Text="Process has active child tasks. Terminating the root without terminating its children may leave orphaned processes running in the background."
                           FontSize="12"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           LineHeight="18"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 3. Connected Process Graph Area -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushCanvas}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GraphContainer">
                        <!-- Dynamically populated tree -->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 4. Descendants List Summary -->
            <Border Grid.Row="3"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,16">
                <TextBlock x:Name="TextTargetList"
                           Text="Target processes: "
                           FontSize="11"
                           FontFamily="{DynamicResource FontFamilyNumeric}"
                           Foreground="{DynamicResource BrushTextSecondary}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 5. Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Terminate entire tree (Danger Action) -->
                <Button Grid.Column="0"
                        x:Name="ButtonTerminateTree"
                        Background="{DynamicResource BrushAccentDanger}"
                        Foreground="{DynamicResource BrushButtonTextOnAccent}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontFamily="{DynamicResource FontFamilyUI}"
                        FontSize="12"
                        Padding="16,8"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        IsDefault="True"
                        AutomationProperties.Name="Terminate entire process tree"
                        Click="OnTerminateTreeClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Terminate entire tree" />
                </Button>

                <!-- Kill root only (Secondary Action) -->
                <Button Grid.Column="1"
                        Background="{DynamicResource BrushSurfaceRaised}"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        FontWeight="Medium"
                        FontFamily="{DynamicResource FontFamilyUI}"
                        FontSize="12"
                        Padding="14,8"
                        Margin="10,0"
                        Cursor="Hand"
                        AutomationProperties.Name="Kill root process only"
                        Click="OnTerminateRootOnlyClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Kill root only" />
                </Button>

                <!-- Cancel (Tertiary Action) -->
                <Button Grid.Column="2"
                        Background="Transparent"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        FontWeight="Normal"
                        FontFamily="{DynamicResource FontFamilyUI}"
                        FontSize="12"
                        Padding="14,8"
                        Cursor="Hand"
                        IsCancel="True"
                        AutomationProperties.Name="Cancel"
                        Click="OnCancelClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="Cancel" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
