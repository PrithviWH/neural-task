<UserControl x:Class="NeuralTask.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             d:DesignHeight="750" d:DesignWidth="980"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Modern Clarity Toggle Switch Style -->
        <Style x:Key="ClarityToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Width="38" Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1.5">
                            <Ellipse x:Name="ToggleThumb"
                                     Width="14" Height="14"
                                     Fill="{DynamicResource BrushTextTertiary}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource BrushButtonTextOnAccent}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="ClaritySecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushTableHover}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushTableSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Elevation Button Style -->
        <Style x:Key="ClarityWarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAccentWarning}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushButtonTextOnAccent}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2. Admin Elevation Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3. Status Notification -->
            <RowDefinition Height="Auto" />
            <!-- 4. Toolbar & Filter -->
            <RowDefinition Height="Auto" />
            <!-- 5. List Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Startup apps"
                           FontSize="20"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Boot impact matrix • Measured impact scoring (0–100)"
                           FontSize="12"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Mode Tag Badge -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,5"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6"
                             Fill="{DynamicResource BrushAccentPrimary}"
                             Margin="0,0,8,0" />
                    <TextBlock Text="Sampling correlation engine"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 1. Top Summary KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Startup Apps -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Registered apps"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding TotalStartupApps}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushAccentPrimary}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Registry &amp; startup folders"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Average Impact Score -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Average boot impact"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AverageImpactScore}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentSecondary}" />
                        <TextBlock Text="/ 100"
                                   FontSize="12"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,4" />
                    </StackPanel>
                    <TextBlock Text="Aggregate startup load"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 3: High Impact Offenders -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="High impact apps"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                    <TextBlock Text="{Binding HighImpactCount}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyNumeric}"
                               Foreground="{DynamicResource BrushAccentWarning}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Impact score ≥ 60 pts"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Administrative Elevation Banner -->
        <Border Grid.Row="2"
                Margin="0,0,0,14"
                Background="{DynamicResource BrushSurfaceRaised}"
                BorderBrush="{DynamicResource BrushAccentWarning}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Visibility="{Binding AdminBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Shield Icon -->
                <Path Grid.Column="0"
                      Data="{StaticResource IconShieldGeometry}"
                      Stroke="{DynamicResource BrushAccentWarning}"
                      StrokeThickness="1.5"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0" />

                <!-- Banner Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Elevation recommended"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushAccentWarning}" />
                    <TextBlock Text="Machine-wide startup entries (HKLM) require administrator privileges to toggle. You can review all scores now, or relaunch with elevation to modify all entries."
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Relaunch Action Button -->
                <Button Grid.Column="2"
                        Content="Relaunch as administrator"
                        Style="{StaticResource ClarityWarningButtonStyle}"
                        Command="{Binding RelaunchAsAdminCommand}"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0" />

                <!-- Dismiss Button -->
                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource ClaritySecondaryButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Padding="8,5"
                        AutomationProperties.Name="Dismiss notification"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. Status Notification Banner -->
        <Border Grid.Row="3"
                Margin="0,0,0,14"
                Background="{DynamicResource BrushSurfaceRaised}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource ClaritySecondaryButtonStyle}"
                        Command="{Binding DismissStatusNotificationCommand}"
                        Padding="8,4"
                        AutomationProperties.Name="Dismiss status"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 4. Toolbar & Filter Section -->
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search / Filter Input -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,7"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource IconSearchGeometry}"
                          Stroke="{DynamicResource BrushTextTertiary}"
                          StrokeThickness="1.5"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="2,0,8,0" />

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource BrushTextPrimary}"
                             CaretBrush="{DynamicResource BrushTextPrimary}"
                             FontFamily="{DynamicResource FontFamilyUI}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Filter startup apps" />

                    <TextBlock Grid.Column="1"
                               Text="Filter startup entries by name, command, location or rating..."
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               FontSize="12"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Refresh Button -->
            <Button Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource ClaritySecondaryButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Padding="16,7"
                    AutomationProperties.Name="Refresh startup matrix" />
        </Grid>

        <!-- 5. Content Area: List + Empty State + Loading State -->
        <Grid Grid.Row="5">
            <!-- Scrollable Startup Entries List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StartupEntryItemViewModel}">
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.03" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Main Row -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Expandable Breakdown Detail Drawer -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 0. Main Row Content -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <!-- Toggle Switch -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Entry Info -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Score & Split Meter -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Action / Expand Button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Toggle CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ClarityToggleStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,16,0"
                                                  ToolTip="Enable or disable startup execution"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Toggle {0} on startup'}" />

                                        <!-- Entry Info (Name, Source Badge, Location/Command) -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushTextPrimary}" />

                                                <!-- Source Badge -->
                                                <Border Margin="10,0,0,0"
                                                        Background="{DynamicResource BrushSurfaceRaised}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceTypeDisplay}"
                                                               FontSize="10"
                                                               FontFamily="{DynamicResource FontFamilyUI}"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Border>

                                                <!-- Live Running Indicator -->
                                                <Border Margin="6,0,0,0"
                                                        Background="{DynamicResource BrushSurfaceRaised}"
                                                        BorderBrush="{DynamicResource BrushAccentSecondary}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Running now"
                                                               FontSize="9"
                                                               FontWeight="Medium"
                                                               FontFamily="{DynamicResource FontFamilyUI}"
                                                               Foreground="{DynamicResource BrushAccentSecondary}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Command}"
                                                       FontSize="11"
                                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <!-- Score Badge & Dual Progress Meter -->
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Score Header & Rating Label -->
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Score}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{DynamicResource FontFamilyNumeric}"
                                                               Foreground="{Binding ImpactBrush}" />
                                                    <TextBlock Text="/ 100"
                                                               FontSize="10"
                                                               FontFamily="{DynamicResource FontFamilyNumeric}"
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               VerticalAlignment="Bottom"
                                                               Margin="3,0,0,2" />
                                                </StackPanel>

                                                <Border HorizontalAlignment="Right"
                                                        BorderBrush="{Binding ImpactBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding ImpactRating}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{DynamicResource FontFamilyUI}"
                                                               Foreground="{Binding ImpactBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Dual-Color Split Meter Bar (Indigo = Time, Teal = Resource) -->
                                            <Border Grid.Row="1"
                                                    Height="6"
                                                    Width="180"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource BrushSurfaceRaised}"
                                                    ClipToBounds="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Time Component (Indigo) -->
                                                    <Rectangle Width="{Binding TimeBarWidth}" Height="6" Fill="{DynamicResource BrushAccentPrimary}" />
                                                    <!-- Resource Component (Teal) -->
                                                    <Rectangle Width="{Binding ResourceBarWidth}" Height="6" Fill="{DynamicResource BrushAccentSecondary}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Ratio Subtitle -->
                                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding TimeScore, StringFormat='Time: {0:0.0} pts'}"
                                                           FontSize="9"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushAccentPrimary}"
                                                           HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding ResourceScore, StringFormat='Res: {0:0.0} pts'}"
                                                           FontSize="9"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushAccentSecondary}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>

                                        <!-- Expand / Explain Button -->
                                        <Button Grid.Column="3"
                                                Content="Explain ▾"
                                                Style="{StaticResource ClaritySecondaryButtonStyle}"
                                                Command="{Binding ToggleExpandCommand}"
                                                VerticalAlignment="Center"
                                                Padding="10,6"
                                                AutomationProperties.Name="Explain boot impact breakdown" />
                                    </Grid>

                                    <!-- 1. Expandable Breakdown Drawer -->
                                    <Border Grid.Row="1"
                                            Margin="0,14,0,0"
                                            Padding="16,12"
                                            Background="{DynamicResource BrushSurfaceRaised}"
                                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Header line -->
                                            <TextBlock Text="Measured impact telemetry"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{DynamicResource FontFamilyUI}"
                                                       Foreground="{DynamicResource BrushTextPrimary}"
                                                       Margin="0,0,0,10" />

                                            <!-- 3 Metric Telemetry Blocks -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Metric 1: Time Window -->
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Init duration"
                                                                   FontSize="10"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                                        <TextBlock Text="{Binding ActiveDurationSeconds, StringFormat='{}{0:0.0}s active'}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding BootDelaySeconds, StringFormat='Delay: {0:0.0}s'}"
                                                                   FontSize="9"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Metric 2: CPU Time -->
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,8,0">
                                                    <StackPanel>
                                                        <TextBlock Text="CPU time"
                                                                   FontSize="10"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                                        <TextBlock Text="{Binding CpuTimeSeconds, StringFormat='{}{0:0.00}s'}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                                                   Foreground="{DynamicResource BrushAccentSecondary}"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="Core load share"
                                                                   FontSize="9"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Metric 3: Disk I/O -->
                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8">
                                                    <StackPanel>
                                                        <TextBlock Text="Storage I/O"
                                                                   FontSize="10"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextSecondary}" />
                                                        <TextBlock Text="{Binding IoDisplay}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="Read &amp; write throughput"
                                                                   FontSize="9"
                                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                                   Foreground="{DynamicResource BrushTextTertiary}"
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Human-readable explanation sentence -->
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Target location path -->
                                            <TextBlock Text="{Binding Location, StringFormat='Location: {0}'}"
                                                       FontSize="10"
                                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty Search State Overlay -->
            <Border Background="{DynamicResource BrushCanvas}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="32,24"
                    CornerRadius="12"
                    Visibility="{Binding HasNoEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconSearchGeometry}"
                          Stroke="{DynamicResource BrushTextTertiary}"
                          StrokeThickness="1.5"
                          Width="28" Height="28"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,12" />
                    <TextBlock Text="No startup apps found"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No startup items match your filter criteria."
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,14" />
                    <Button Content="Clear filter"
                            Style="{StaticResource ClaritySecondaryButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Center"
                            Padding="16,6" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
