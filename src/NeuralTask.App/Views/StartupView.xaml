<UserControl x:Class="NeuralTask.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
             xmlns:conv="clr-namespace:NeuralTask.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}"
             d:DesignHeight="750" d:DesignWidth="980"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Card Drop Shadow Effect -->
        <DropShadowEffect x:Key="ClarityCardShadow"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.12" />

        <!-- Premium Fluid Toggle Switch Style (iOS / Linear Style) -->
        <Style x:Key="ClarityModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleTrack"
                                Width="40" Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                BorderThickness="1.5">
                            <Grid>
                                <Ellipse x:Name="ToggleThumb"
                                         Width="14" Height="14"
                                         Fill="{DynamicResource BrushTextTertiary}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource BrushAccentPrimary}" />
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FFFFFFFF" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource BrushAccentPrimary}" />
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clarity Filter Pill Button Style -->
        <Style x:Key="ClarityFilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button Style -->
        <Style x:Key="ClaritySecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Elevation Button Style -->
        <Style x:Key="ClarityWarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushAccentWarning}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushButtonTextOnAccent}" />
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyUI}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clarity Slim ScrollBar Style -->
        <Style x:Key="ClaritySlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="MinWidth" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource BrushBorderStrong}" Opacity="0.5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clarity Slim ScrollViewer Style -->
        <Style x:Key="ClaritySlimScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource ClaritySlimScrollBarStyle}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="4,0,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. KPI Cards -->
            <RowDefinition Height="Auto" />
            <!-- 2. Admin Elevation Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3. Status Notification -->
            <RowDefinition Height="Auto" />
            <!-- 4. Category Filter Tabs & Search Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 5. Content Area (Scrollable List / Empty State) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 0. Header Section                                                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Startup Apps"
                           FontSize="20"
                           FontWeight="SemiBold"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Boot impact matrix • Measured startup impact scoring (0–100)"
                           FontSize="11"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextTertiary}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Mode Tag Badge -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,5"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushAccentPrimary}" Opacity="0.3" />
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource BrushAccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Sampling correlation engine active"
                               FontSize="10.5"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 1. Top Summary KPI Cards                                                  -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Total Startup Apps -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    Effect="{StaticResource ClarityCardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="REGISTERED APPS"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyCode}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource BrushAccentPrimarySoft}">
                            <Path Data="{StaticResource IconStartupGeometry}"
                                  Stroke="{DynamicResource BrushAccentPrimary}"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding TotalStartupApps}"
                               FontSize="26"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyCode}"
                               Foreground="{DynamicResource BrushAccentPrimary}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="Registry &amp; shell startup folders"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 2: Average Impact Score -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    Effect="{StaticResource ClarityCardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="AVG BOOT IMPACT"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyCode}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource BrushAccentSecondarySoft}">
                            <Path Data="{StaticResource IconActivityGeometry}"
                                  Stroke="{DynamicResource BrushAccentSecondary}"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding AverageImpactScore}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyCode}"
                                   Foreground="{DynamicResource BrushAccentSecondary}" />
                        <TextBlock Text="/ 100"
                                   FontSize="12"
                                   FontFamily="{DynamicResource FontFamilyCode}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Bottom"
                                   Margin="4,0,0,4" />
                    </StackPanel>
                    <TextBlock Text="Aggregate startup resource load"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- KPI 3: High Impact Offenders -->
            <Border Grid.Column="4"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14"
                    Effect="{StaticResource ClarityCardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="HIGH IMPACT OVERHEAD"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   FontFamily="{DynamicResource FontFamilyCode}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                Width="26" Height="26" CornerRadius="6"
                                Background="{DynamicResource BrushAccentWarningSoft}">
                            <Path Data="{StaticResource IconWarningGeometry}"
                                  Stroke="{DynamicResource BrushAccentWarning}"
                                  StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding HighImpactCount}"
                               FontSize="26"
                               FontWeight="Bold"
                               FontFamily="{DynamicResource FontFamilyCode}"
                               Foreground="{DynamicResource BrushAccentWarning}"
                               Margin="0,2,0,0" />
                    <TextBlock Text="Impact rating score ≥ 60 pts"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. Administrative Elevation Banner                                        -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Margin="0,0,0,14"
                Background="{DynamicResource BrushSurfaceRaised}"
                BorderBrush="{DynamicResource BrushAccentWarning}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Visibility="{Binding AdminBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0"
                      Data="{StaticResource IconShieldGeometry}"
                      Stroke="{DynamicResource BrushAccentWarning}"
                      StrokeThickness="1.5"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Elevation recommended"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushAccentWarning}" />
                    <TextBlock Text="Machine-wide startup entries (HKLM) require administrator privileges to toggle. You can review all scores now, or relaunch with elevation to modify all entries."
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Relaunch as administrator"
                        Style="{StaticResource ClarityWarningButtonStyle}"
                        Command="{Binding RelaunchAsAdminCommand}"
                        VerticalAlignment="Center"
                        Margin="12,0,8,0" />

                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource ClaritySecondaryButtonStyle}"
                        Command="{Binding DismissBannerCommand}"
                        Padding="8,5"
                        AutomationProperties.Name="Dismiss notification"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 3. Status Notification Banner                                             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="3"
                Margin="0,0,0,14"
                Background="{DynamicResource BrushSurfaceRaised}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontFamily="{DynamicResource FontFamilyUI}"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource ClaritySecondaryButtonStyle}"
                        Command="{Binding DismissStatusNotificationCommand}"
                        Padding="8,4"
                        AutomationProperties.Name="Dismiss status"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 4. Category Filter Tabs & Search Toolbar                                  -->
        <!-- ========================================================================= -->
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <!-- Row 4a: Category Filter Pills -->
            <Border Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab: All -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="All">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="All" />
                            <TextBlock Text="{Binding TotalStartupApps, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Enabled -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="Enabled">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterEnabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Enabled" />
                            <TextBlock Text="{Binding EnabledCount, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Disabled -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="Disabled">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterDisabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Disabled" />
                            <TextBlock Text="{Binding DisabledCount, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: High Impact -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="HighImpact">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterHighImpact}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="High Impact" />
                            <TextBlock Text="{Binding HighImpactCount, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Registry -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="Registry">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterRegistry}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Registry" />
                            <TextBlock Text="{Binding RegistryCount, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>

                    <!-- Tab: Folders -->
                    <Button Command="{Binding SetFilterCategoryCommand}" CommandParameter="Folders">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ClarityFilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterFolders}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushAccentPrimarySoft}" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Startup Folders" />
                            <TextBlock Text="{Binding FoldersCount, StringFormat=' ({0})'}" Foreground="{DynamicResource BrushTextTertiary}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Row 4b: Search Box & Refresh Matrix Button -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input with Clear Button -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,7"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="{StaticResource IconSearchGeometry}"
                              Stroke="{DynamicResource BrushTextTertiary}"
                              StrokeThickness="1.5"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="2,0,8,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushTextPrimary}"
                                 FontFamily="{DynamicResource FontFamilyUI}"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Filter startup apps" />

                        <TextBlock Grid.Column="1"
                                   Text="Filter startup entries by name, command, location or rating..."
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Clear Search Button -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource ClarityFilterPillStyle}"
                                Padding="4,2"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Clear filter (Esc)"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource BrushTextTertiary}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ClaritySecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Padding="14,7"
                        ToolTip="Re-enumerate all startup entries from registry and shell folders"
                        AutomationProperties.Name="Refresh startup matrix">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScanGeometry}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5"
                              Width="12" Height="12" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh Matrix" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ========================================================================= -->
        <!-- 5. Content Area: List + Empty State                                       -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="5">
            <!-- Scrollable Startup Entries List with Slim ScrollBar -->
            <ScrollViewer Style="{StaticResource ClaritySlimScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding FilteredEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StartupEntryItemViewModel}">
                            <Border Margin="0,0,0,10"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14"
                                    Effect="{StaticResource ClarityCardShadow}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Main Row Summary -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Expandable Breakdown Detail Drawer -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 0. Main Row Content -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <!-- 0. Toggle Switch -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- 1. Native App Icon Container -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- 2. Entry Info -->
                                            <ColumnDefinition Width="*" />
                                            <!-- 3. Score & Split Meter -->
                                            <ColumnDefinition Width="220" />
                                            <!-- 4. Action / Expand Button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Toggle CheckBox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource ClarityModernToggleStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"
                                                  ToolTip="Enable or disable startup execution"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Toggle {0} on startup'}" />

                                        <!-- Native App Icon Container -->
                                        <Border Grid.Column="1"
                                                Width="38" Height="38"
                                                CornerRadius="9"
                                                Background="{DynamicResource BrushSurfaceRaised}"
                                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                BorderThickness="1"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding Icon}"
                                                       Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Path Data="{StaticResource IconStartupGeometry}"
                                                      Stroke="{DynamicResource BrushTextTertiary}"
                                                      StrokeThickness="1.5"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Entry Info (Name, Source Badge, Running Chip, Command) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="340" />

                                                <!-- Source Badge -->
                                                <Border Margin="10,0,0,0"
                                                        Background="{DynamicResource BrushSurfaceRaised}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SourceTypeBadgeText}"
                                                               FontSize="9.5"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                </Border>

                                                <!-- Live Running Indicator -->
                                                <Border Margin="6,0,0,0"
                                                        Background="#1810B981"
                                                        BorderBrush="#3510B981"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding RunningDisplay}"
                                                                   FontSize="9.5"
                                                                   FontWeight="SemiBold"
                                                                   FontFamily="{DynamicResource FontFamilyCode}"
                                                                   Foreground="#10B981" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Command Line -->
                                            <TextBlock Text="{Binding Command}"
                                                       FontSize="11"
                                                       FontFamily="{DynamicResource FontFamilyCode}"
                                                       Foreground="{DynamicResource BrushTextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"
                                                       ToolTip="{Binding Command}" />
                                        </StackPanel>

                                        <!-- Score Badge & Dual Segmented Progress Meter -->
                                        <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Score Header & Rating Pill -->
                                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Score}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{Binding ImpactBrush}" />
                                                    <TextBlock Text="/ 100"
                                                               FontSize="10"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               VerticalAlignment="Bottom"
                                                               Margin="3,0,0,2" />
                                                </StackPanel>

                                                <!-- Rating Pill -->
                                                <Border HorizontalAlignment="Right"
                                                        Background="{Binding ImpactBadgeBackground}"
                                                        BorderBrush="{Binding ImpactBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding ImpactRating}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               FontFamily="{DynamicResource FontFamilyUI}"
                                                               Foreground="{Binding ImpactBadgeForeground}" />
                                                </Border>
                                            </Grid>

                                            <!-- Dual-Color Segmented Track (Indigo = Time, Teal = Resource) -->
                                            <Border Grid.Row="1"
                                                    Height="5"
                                                    Width="180"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="2.5"
                                                    Background="{DynamicResource BrushBorderSubtle}"
                                                    ClipToBounds="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Width="{Binding TimeBarWidth}" Height="5" Fill="{DynamicResource BrushAccentPrimary}" />
                                                    <Rectangle Width="{Binding ResourceBarWidth}" Height="5" Fill="{DynamicResource BrushAccentSecondary}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Telemetry Micro Metrics -->
                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrushAccentPrimary}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeScore, StringFormat='Time: {0:0.0} pts'}"
                                                               FontSize="9"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{DynamicResource BrushAccentPrimary}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource BrushAccentSecondary}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ResourceScore, StringFormat='Res: {0:0.0} pts'}"
                                                               FontSize="9"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{DynamicResource BrushAccentSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- Expand / Details Button -->
                                        <Button Grid.Column="4"
                                                Style="{StaticResource ClaritySecondaryButtonStyle}"
                                                Command="{Binding ToggleExpandCommand}"
                                                VerticalAlignment="Center"
                                                Padding="10,6"
                                                ToolTip="View measured telemetry breakdown"
                                                AutomationProperties.Name="Explain boot impact breakdown">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Telemetry" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <Path Data="{StaticResource IconChevronDownGeometry}"
                                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      StrokeThickness="1.5"
                                                      Width="9" Height="9" Stretch="Uniform"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 1. Expandable Telemetry Breakdown Drawer -->
                                    <Border Grid.Row="1"
                                            Margin="0,14,0,0"
                                            Padding="16,14"
                                            Background="{DynamicResource BrushSurfaceRaised}"
                                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!-- Drawer Title -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconActivityGeometry}"
                                                          Stroke="{DynamicResource BrushAccentPrimary}"
                                                          StrokeThickness="1.5"
                                                          Width="13" Height="13" Stretch="Uniform"
                                                          Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="MEASURED BOOT TELEMETRY BREAKDOWN"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               FontFamily="{DynamicResource FontFamilyCode}"
                                                               Foreground="{DynamicResource BrushTextTertiary}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CleanExecutableName}"
                                                           FontSize="10"
                                                           FontFamily="{DynamicResource FontFamilyCode}"
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- 3 Telemetry HUD Blocks -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Metric 1: Active Duration -->
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="INIT DURATION" FontSize="9" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconActivityGeometry}" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Opacity="0.7" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding ActiveDurationSeconds, StringFormat='{}{0:0.0}s active'}"
                                                                   FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,0,2" />
                                                        <TextBlock Text="{Binding BootDelaySeconds, StringFormat='Boot delay: {0:0.0}s'}"
                                                                   FontSize="9.5" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Metric 2: CPU Time -->
                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="CPU EXECUTION" FontSize="9" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconCpuGeometry}" Stroke="{DynamicResource BrushAccentSecondary}" StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Opacity="0.85" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding CpuTimeSeconds, StringFormat='{}{0:0.00}s'}"
                                                                   FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushAccentSecondary}" Margin="0,2,0,2" />
                                                        <TextBlock Text="Core execution load share"
                                                                   FontSize="9.5" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Metric 3: Disk I/O -->
                                                <Border Grid.Column="4"
                                                        Background="{DynamicResource BrushSurface}"
                                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="STORAGE I/O" FontSize="9" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                            <Path HorizontalAlignment="Right" Data="{StaticResource IconDatabaseGeometry}" Stroke="{DynamicResource BrushAccentPrimary}" StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" Opacity="0.85" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding IoDisplay}"
                                                                   FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontFamilyCode}" Foreground="{DynamicResource BrushAccentPrimary}" Margin="0,2,0,2" />
                                                        <TextBlock Text="Read &amp; write throughput"
                                                                   FontSize="9.5" FontFamily="{DynamicResource FontFamilyUI}" Foreground="{DynamicResource BrushTextTertiary}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Human-readable Explanation Summary -->
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <!-- Location Path Chip -->
                                            <Border Background="{DynamicResource BrushSurface}"
                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8,5">
                                                <TextBlock Text="{Binding Location, StringFormat='Location: {0}'}"
                                                           FontSize="10"
                                                           FontFamily="{DynamicResource FontFamilyCode}"
                                                           Foreground="{DynamicResource BrushTextTertiary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Location}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty Search State Overlay -->
            <Border Background="{DynamicResource BrushCanvas}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="32,24"
                    CornerRadius="12"
                    Visibility="{Binding HasNoEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconSearchGeometry}"
                          Stroke="{DynamicResource BrushTextTertiary}"
                          StrokeThickness="1.5"
                          Width="28" Height="28"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,12" />
                    <TextBlock Text="No startup apps found"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No startup items match your filter criteria."
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,14" />
                    <Button Content="Clear search filter"
                            Style="{StaticResource ClaritySecondaryButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Center"
                            Padding="16,6" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
