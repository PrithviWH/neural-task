<UserControl x:Class="NeuralTask.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Settings"
                               FontSize="20"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="Preferences • Display, telemetry and plugin configuration"
                               FontSize="12"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 2. Visual Theme Card (Clarity Dark vs Clarity Light) -->
            <Border Grid.Row="1"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Appearance"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Switch between Clarity Dark and Clarity Light palettes live without restarting."
                               FontSize="12"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,16" />

                    <!-- Radio buttons for Theme selection -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Dark Theme Option Card -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton GroupName="ThemeGroup"
                                                 IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Select Clarity Dark theme" />
                                    <TextBlock Text="Clarity Dark"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="{DynamicResource FontFamilyUI}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Refined dark slate canvas (#111319) with deep charcoal cards (#181B22) and soft indigo accents."
                                           FontSize="11"
                                           FontFamily="{DynamicResource FontFamilyUI}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Light Theme Option Card -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14"
                                Cursor="Hand">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton GroupName="ThemeGroup"
                                                 IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Select Clarity Light theme" />
                                    <TextBlock Text="Clarity Light"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               FontFamily="{DynamicResource FontFamilyUI}"
                                               Foreground="{DynamicResource BrushTextPrimary}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Calm off-white canvas (#F6F7FB) with crisp white cards (#FFFFFF), high contrast text, and indigo accents."
                                           FontSize="11"
                                           FontFamily="{DynamicResource FontFamilyUI}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Ambient Animation Layer Toggle -->
            <Border Grid.Row="2"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Background effects"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Enables calm background canvas gradients. Disable for minimal power consumption."
                                   FontSize="12"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsAmbientAnimationEnabled, Mode=TwoWay}"
                              Content="Enabled"
                              FontSize="12"
                              FontWeight="Medium"
                              FontFamily="{DynamicResource FontFamilyUI}"
                              Foreground="{DynamicResource BrushTextPrimary}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Enable background effects" />
                </Grid>
            </Border>

            <!-- 4. Telemetry Sampling Frequency -->
            <Border Grid.Row="3"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Telemetry refresh rate"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Controls the sampling frequency for process enumeration and resource delta calculations."
                               FontSize="12"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="500 ms (Fast)"
                                     GroupName="IntervalGroup"
                                     IsChecked="{Binding IsInterval500, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     Margin="0,0,24,0"
                                     AutomationProperties.Name="500 milliseconds refresh rate" />
                        <RadioButton Content="1000 ms (Recommended)"
                                     GroupName="IntervalGroup"
                                     IsChecked="{Binding IsInterval1000, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Margin="0,0,24,0"
                                     AutomationProperties.Name="1000 milliseconds refresh rate" />
                        <RadioButton Content="2000 ms (Power saver)"
                                     GroupName="IntervalGroup"
                                     IsChecked="{Binding IsInterval2000, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     AutomationProperties.Name="2000 milliseconds refresh rate" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. System Tray Engine & Mini-Graph -->
            <Border Grid.Row="4"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="System tray"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Minimizes to the Windows notification area on window close. Click the tray icon to restore."
                                       FontSize="12"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsMinimizeToTrayEnabled, Mode=TwoWay}"
                                  Content="Enabled"
                                  FontSize="12"
                                  FontWeight="Medium"
                                  FontFamily="{DynamicResource FontFamilyUI}"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Minimize to system tray" />
                    </Grid>

                    <TextBlock Text="Tray icon live metric"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,6,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="CPU load (Indigo)"
                                     GroupName="TrayMetricGroup"
                                     IsChecked="{Binding IsTrayMetricCpu, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Margin="0,0,24,0"
                                     AutomationProperties.Name="Show CPU load in tray icon" />
                        <RadioButton Content="RAM load (Teal)"
                                     GroupName="TrayMetricGroup"
                                     IsChecked="{Binding IsTrayMetricRam, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentSecondary}"
                                     AutomationProperties.Name="Show RAM load in tray icon" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 6. Local Heuristic Engine & Non-AV Disclaimer -->
            <Border Grid.Row="5"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Anomaly detection"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Highlights unusual execution directories (%TEMP%, Downloads), unsigned binaries, and sudden resource spikes."
                               FontSize="12"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,14" />

                    <!-- Sensitivity Radios -->
                    <TextBlock Text="Heuristic sensitivity profile"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Conservative (Developer friendly)"
                                     GroupName="SensitivityGroup"
                                     IsChecked="{Binding IsSensitivityConservative, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Margin="0,0,20,0"
                                     ToolTip="Suppresses alerts on developer directories (npm, cargo, venv)."
                                     AutomationProperties.Name="Conservative sensitivity profile" />
                        <RadioButton Content="Standard"
                                     GroupName="SensitivityGroup"
                                     IsChecked="{Binding IsSensitivityStandard, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     Margin="0,0,20,0"
                                     AutomationProperties.Name="Standard sensitivity profile" />
                        <RadioButton Content="Aggressive"
                                     GroupName="SensitivityGroup"
                                     IsChecked="{Binding IsSensitivityAggressive, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentWarning}"
                                     AutomationProperties.Name="Aggressive sensitivity profile" />
                    </StackPanel>

                    <!-- Persistent Disclaimer Callout Box -->
                    <Border Background="{DynamicResource BrushSurfaceRaised}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="{StaticResource IconShieldGeometry}"
                                  Stroke="{DynamicResource BrushAccentWarning}"
                                  StrokeThickness="1.5"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  Margin="0,0,14,0"
                                  VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Diagnostic notice: Not an antivirus or malware scanner"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           FontFamily="{DynamicResource FontFamilyUI}"
                                           Foreground="{DynamicResource BrushAccentWarning}" />
                                <TextBlock Text="NeuralTask heuristic flags are diagnostic aids intended solely to highlight potential anomalies for user triage. This software is not an antivirus product, does not provide endpoint threat protection, and must not be used as a substitute for certified security software."
                                           FontSize="11"
                                           FontFamily="{DynamicResource FontFamilyUI}"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 7. Historical Telemetry & Persistence -->
            <Border Grid.Row="6"
                    Margin="0,0,0,16"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Historical telemetry"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Retains a rolling telemetry buffer enabling timeline scrubbing. Optionally persist samples to local disk across restarts."
                                       FontSize="12"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding IsHistoryPersistenceEnabled, Mode=TwoWay}"
                                  Content="Persist to disk"
                                  FontSize="12"
                                  FontWeight="Medium"
                                  FontFamily="{DynamicResource FontFamilyUI}"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Persist telemetry buffer to disk" />
                    </Grid>

                    <TextBlock Text="Rolling retention window"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               Margin="0,4,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="15 minutes"
                                     GroupName="RetentionGroup"
                                     IsChecked="{Binding IsRetention15, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     Margin="0,0,24,0"
                                     AutomationProperties.Name="15 minutes retention window" />
                        <RadioButton Content="30 minutes (Recommended)"
                                     GroupName="RetentionGroup"
                                     IsChecked="{Binding IsRetention30, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Margin="0,0,24,0"
                                     AutomationProperties.Name="30 minutes retention window" />
                        <RadioButton Content="60 minutes"
                                     GroupName="RetentionGroup"
                                     IsChecked="{Binding IsRetention60, Mode=TwoWay}"
                                     FontSize="12"
                                     FontFamily="{DynamicResource FontFamilyUI}"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     AutomationProperties.Name="60 minutes retention window" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 8. Extension Plugins -->
            <Border Grid.Row="7"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,18"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Extension plugins"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="Discovers and dynamically isolates third-party DLL panels from the local /plugins directory."
                                       FontSize="12"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource BrushSurfaceRaised}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Plugins directory:"
                                       FontSize="11"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding PluginsDirectory, FallbackValue='(local)/plugins'}"
                                       FontSize="11"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushAccentPrimary}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Plugin Items List -->
                    <ItemsControl ItemsSource="{Binding LoadedPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushSurfaceRaised}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                                <TextBlock Text="{Binding Id, StringFormat='  [{0}]'}"
                                                           FontSize="11"
                                                           FontFamily="{DynamicResource FontFamilyNumeric}"
                                                           Foreground="{DynamicResource BrushTextTertiary}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       FontFamily="{DynamicResource FontFamilyUI}"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource BrushAccentPrimarySoft}"
                                                    BorderBrush="{DynamicResource BrushAccentPrimary}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="Active"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           FontFamily="{DynamicResource FontFamilyUI}"
                                                           Foreground="{DynamicResource BrushAccentPrimary}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 9. Privacy & Platform Attribution -->
            <Border Grid.Row="8"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="{StaticResource IconShieldGeometry}"
                          Stroke="{DynamicResource BrushAccentPrimary}"
                          StrokeThickness="1.5"
                          Width="20" Height="20"
                          Stretch="Uniform"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Local telemetry only • Zero external network calls"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="NeuralTask operates strictly on native local Win32 kernel structures. No process identifiers, memory snapshots, or telemetry pings ever leave your machine."
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
