<Window x:Class="NeuralTask.App.Views.ConfirmKillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirm Process Termination"
        Height="360" Width="480"
        MinHeight="320" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BrushSurface}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Background="{DynamicResource BrushSurface}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16" x:Name="DialogHeaderBar" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource BrushAccentDangerSoft}" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconKillGeometry}"
                              Stroke="{DynamicResource BrushAccentDanger}"
                              StrokeThickness="2"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="End Task Confirmation"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="NeuralTask Process Action Safety"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextTertiary}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        FontSize="13"
                        Foreground="{DynamicResource BrushTextSecondary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="28" Height="28"
                        Cursor="Hand"
                        IsCancel="True"
                        AutomationProperties.Name="Close dialog"
                        Click="OnCancelClick" />
            </Grid>

            <!-- 2. Target Identification Card -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BrushSurfaceRaised}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TextProcessName"
                                       Text="target_process.exe"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock x:Name="TextPid"
                                       Text="PID: 12345"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyCode}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="TextExecutablePath"
                               Text="C:\Program Files\App\target.exe"
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyCode}"
                               Foreground="{DynamicResource BrushTextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. Warning Description -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushCanvas}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Are you sure you want to terminate this process?"
                               FontSize="12"
                               FontWeight="Medium"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="If you close this process, any unsaved work or state will be lost immediately. System and background services may automatically restart."
                               FontSize="11"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               LineHeight="16"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 4. Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Background="{DynamicResource BrushSurfaceRaised}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        Foreground="{DynamicResource BrushTextPrimary}"
                        FontFamily="{DynamicResource FontFamilyUI}"
                        FontSize="12"
                        FontWeight="Medium"
                        Padding="16,8"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCancelClick" />

                <Button Grid.Column="2"
                        Content="End Process"
                        Background="{DynamicResource BrushAccentDanger}"
                        BorderThickness="0"
                        Foreground="#FFFFFFFF"
                        FontFamily="{DynamicResource FontFamilyUI}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Padding="16,8"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="OnConfirmClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
