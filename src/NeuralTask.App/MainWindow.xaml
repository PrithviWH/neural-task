<ui:FluentWindow x:Class="NeuralTask.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:NeuralTask.App.Views"
        xmlns:vm="clr-namespace:NeuralTask.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="NeuralTask"
        Height="720"
        Width="1100"
        MinHeight="560"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BrushCanvas}">

    <ui:FluentWindow.Resources>
        <!-- Style for Clarity Navigation Rail Buttons -->
        <Style x:Key="ClarityNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BrushCanvas}">
        <!-- Main Window Structure -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Refined Minimal TitleBar -->
            <ui:TitleBar Grid.Row="0"
                         Title="NeuralTask"
                         Foreground="{DynamicResource BrushTextPrimary}"
                         Height="40"
                         Padding="16,0,0,0">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Live Status Dot -->
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource BrushAccentSecondary}"
                                 Margin="16,0,6,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusBadgeText, FallbackValue='System online'}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <!-- 2. Main Shell Layout (Navigation Rail + Viewport) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Rail with Visible Labels (PRD §5) -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,1,0"
                        Padding="0,12,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Navigation Items -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <!-- Dashboard -->
                            <Border x:Name="BorderDashboard" CornerRadius="8" Width="72" Height="58" Margin="0,3">
                                <Button x:Name="NavButtonDashboard"
                                        Style="{StaticResource ClarityNavButtonStyle}"
                                        ToolTip="Dashboard (Ctrl+1)"
                                        AutomationProperties.Name="Dashboard"
                                        AutomationProperties.ItemType="Navigation Tab"
                                        Click="OnNavDashboardClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconDashboard"
                                              Data="{StaticResource IconDashboardGeometry}"
                                              Stroke="{DynamicResource BrushAccentPrimary}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="20" Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LabelDashboard"
                                                   Text="Dashboard"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Processes -->
                            <Border x:Name="BorderProcesses" CornerRadius="8" Width="72" Height="58" Margin="0,3">
                                <Button x:Name="NavButtonProcesses"
                                        Style="{StaticResource ClarityNavButtonStyle}"
                                        ToolTip="Processes (Ctrl+2)"
                                        AutomationProperties.Name="Processes"
                                        AutomationProperties.ItemType="Navigation Tab"
                                        Click="OnNavProcessesClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconProcesses"
                                              Data="{StaticResource IconProcessesGeometry}"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="20" Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LabelProcesses"
                                                   Text="Processes"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Startup -->
                            <Border x:Name="BorderStartup" CornerRadius="8" Width="72" Height="58" Margin="0,3">
                                <Button x:Name="NavButtonStartup"
                                        Style="{StaticResource ClarityNavButtonStyle}"
                                        ToolTip="Startup Apps (Ctrl+3)"
                                        AutomationProperties.Name="Startup Apps"
                                        AutomationProperties.ItemType="Navigation Tab"
                                        Click="OnNavStartupClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconStartup"
                                              Data="{StaticResource IconStartupGeometry}"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="20" Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LabelStartup"
                                                   Text="Startup"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- Dynamic Plugins Container -->
                            <StackPanel x:Name="NavRailPluginsContainer" />

                            <!-- Settings -->
                            <Border x:Name="BorderSettings" CornerRadius="8" Width="72" Height="58" Margin="0,3">
                                <Button x:Name="NavButtonSettings"
                                        Style="{StaticResource ClarityNavButtonStyle}"
                                        ToolTip="Settings (Ctrl+4)"
                                        AutomationProperties.Name="Settings"
                                        AutomationProperties.ItemType="Navigation Tab"
                                        Click="OnNavSettingsClick">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="IconSettings"
                                              Data="{StaticResource IconSettingsGeometry}"
                                              Stroke="{DynamicResource BrushTextSecondary}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="20" Height="20"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" />
                                        <TextBlock x:Name="LabelSettings"
                                                   Text="Settings"
                                                   FontSize="11"
                                                   FontWeight="Medium"
                                                   FontFamily="{DynamicResource FontFamilyUI}"
                                                   Foreground="{DynamicResource BrushTextSecondary}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>

                        <!-- Bottom Version Info -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                            <TextBlock Text="v0.3"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextTertiary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Viewport Area Hosting Views -->
                <Grid Grid.Column="1" x:Name="ViewportContainer" Background="Transparent">
                    <views:DashboardView x:Name="ViewDashboard" Visibility="Visible" />
                    <views:ProcessListView x:Name="ViewProcesses" Visibility="Collapsed" />
                    <views:StartupView x:Name="ViewStartup" Visibility="Collapsed" />
                    <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed" />
                    <ContentControl x:Name="PluginViewportPresenter" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
