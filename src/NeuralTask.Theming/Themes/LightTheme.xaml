<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- NeuralTask Design Tokens: Light (Holo-Glass) Variant (PRD §13)    -->
    <!-- ================================================================= -->

    <!-- Base Colors -->
    <Color x:Key="ColorBackgroundBase">#FFF1F5F9</Color>
    <Color x:Key="ColorPanelSurface">#D9FFFFFF</Color>
    <Color x:Key="ColorPanelBorder">#FFCBD5E1</Color>
    <Color x:Key="ColorAccentPrimary">#FF00758A</Color>
    <Color x:Key="ColorAccentSecondary">#FF6D28D9</Color>
    <Color x:Key="ColorAccentSuccess">#FF059669</Color>
    <Color x:Key="ColorWarning">#FFB45309</Color>
    <Color x:Key="ColorTextPrimary">#FF0F172A</Color>
    <Color x:Key="ColorTextSecondary">#FF475569</Color>
    <Color x:Key="ColorTableBorder">#FFE2E8F0</Color>
    <Color x:Key="ColorTableHover">#FFF8FAFC</Color>
    <Color x:Key="ColorTableSelected">#FFE0F2FE</Color>
    <Color x:Key="ColorTitleBarForeground">#FF0F172A</Color>
    <Color x:Key="ColorSurfaceCallout">#FFFDF2E9</Color>
    <Color x:Key="ColorSurfaceElevated">#FFF8FAFC</Color>
    <Color x:Key="ColorButtonTextOnAccent">#FFFFFFFF</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBackgroundBase" Color="{StaticResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="BrushPanelSurface" Color="{StaticResource ColorPanelSurface}" />
    <SolidColorBrush x:Key="BrushPanelBorder" Color="{StaticResource ColorPanelBorder}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushAccentSuccess" Color="{StaticResource ColorAccentSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTableBorder" Color="{StaticResource ColorTableBorder}" />
    <SolidColorBrush x:Key="BrushTableHover" Color="{StaticResource ColorTableHover}" />
    <SolidColorBrush x:Key="BrushTableSelected" Color="{StaticResource ColorTableSelected}" />
    <SolidColorBrush x:Key="BrushTitleBarForeground" Color="{StaticResource ColorTitleBarForeground}" />
    <SolidColorBrush x:Key="BrushSurfaceCallout" Color="{StaticResource ColorSurfaceCallout}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />
    <SolidColorBrush x:Key="BrushButtonTextOnAccent" Color="{StaticResource ColorButtonTextOnAccent}" />

    <!-- Typography Tokens -->
    <FontFamily x:Key="FontFamilyNumeric">Cascadia Code, JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontFamilyUI">Segoe UI Variable, Inter, Segoe UI</FontFamily>

</ResourceDictionary>
