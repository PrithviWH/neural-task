<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- NeuralTask Design Tokens: Clarity Light Theme (PRD §2 & §11)      -->
    <!-- Soft neutral cleanroom canvas, soft indigo & teal accents         -->
    <!-- ================================================================= -->

    <!-- Canvas & Surfaces -->
    <Color x:Key="ColorCanvas">#FFF6F7FB</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurfaceRaised">#FFFBFBFE</Color>
    <Color x:Key="ColorBorderSubtle">#FFE6E8F0</Color>
    <Color x:Key="ColorBorderStrong">#FFD7DAE5</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#FF15172B</Color>
    <Color x:Key="ColorTextSecondary">#FF5B5F73</Color>
    <Color x:Key="ColorTextTertiary">#FF9497A8</Color>

    <!-- Accents -->
    <Color x:Key="ColorAccentPrimary">#FF5B61F1</Color>
    <Color x:Key="ColorAccentPrimaryHover">#FF4C52E0</Color>
    <Color x:Key="ColorAccentPrimarySoft">#FFECEDFD</Color>
    <Color x:Key="ColorAccentSecondary">#FF0D827A</Color>
    <Color x:Key="ColorAccentSecondarySoft">#FFE6F7F5</Color>
    <Color x:Key="ColorAccentWarning">#FFB45309</Color>
    <Color x:Key="ColorAccentWarningSoft">#FFFEF3C7</Color>
    <Color x:Key="ColorAccentDanger">#FFC93B41</Color>
    <Color x:Key="ColorAccentDangerSoft">#FFFEECEC</Color>
    <Color x:Key="ColorButtonTextOnAccent">#FFFFFFFF</Color>

    <!-- Aliases for Legacy Compatibility -->
    <Color x:Key="ColorBackgroundBase">#FFF6F7FB</Color>
    <Color x:Key="ColorPanelSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorPanelBorder">#FFE6E8F0</Color>
    <Color x:Key="ColorWarning">#FFB45309</Color>
    <Color x:Key="ColorAccentSuccess">#FF0D827A</Color>
    <Color x:Key="ColorTableBorder">#FFE6E8F0</Color>
    <Color x:Key="ColorTableHover">#FFFBFBFE</Color>
    <Color x:Key="ColorTableSelected">#FFECEDFD</Color>
    <Color x:Key="ColorTitleBarForeground">#FF15172B</Color>
    <Color x:Key="ColorSurfaceCallout">#FFFDF8F2</Color>
    <Color x:Key="ColorSurfaceElevated">#FFFBFBFE</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceRaised" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryHover" Color="{StaticResource ColorAccentPrimaryHover}" />
    <SolidColorBrush x:Key="BrushAccentPrimarySoft" Color="{StaticResource ColorAccentPrimarySoft}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushAccentSecondarySoft" Color="{StaticResource ColorAccentSecondarySoft}" />
    <SolidColorBrush x:Key="BrushAccentWarning" Color="{StaticResource ColorAccentWarning}" />
    <SolidColorBrush x:Key="BrushAccentWarningSoft" Color="{StaticResource ColorAccentWarningSoft}" />
    <SolidColorBrush x:Key="BrushAccentDanger" Color="{StaticResource ColorAccentDanger}" />
    <SolidColorBrush x:Key="BrushAccentDangerSoft" Color="{StaticResource ColorAccentDangerSoft}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushBorderNormal" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushButtonTextOnAccent" Color="{StaticResource ColorButtonTextOnAccent}" />

    <!-- Legacy Brush Aliases -->
    <SolidColorBrush x:Key="BrushBackgroundBase" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushPanelSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushPanelBorder" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorAccentWarning}" />
    <SolidColorBrush x:Key="BrushAccentSuccess" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushTableBorder" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushTableHover" Color="{StaticResource ColorSurfaceRaised}" />
    <SolidColorBrush x:Key="BrushTableSelected" Color="{StaticResource ColorAccentPrimarySoft}" />
    <SolidColorBrush x:Key="BrushTitleBarForeground" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushSurfaceCallout" Color="{StaticResource ColorSurfaceCallout}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />

    <!-- Typography Tokens -->
    <FontFamily x:Key="FontFamilyUI">Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyCode">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="FontFamilyNumeric">JetBrains Mono, Cascadia Code, Consolas</FontFamily>

</ResourceDictionary>
