<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- NeuralTask Design Tokens: Light (Holo-Glass) Variant (PRD §13)    -->
    <!-- ================================================================= -->

    <!-- Base Colors -->
    <Color x:Key="ColorBackgroundBase">#FFF4F6FA</Color>
    <Color x:Key="ColorPanelSurface">#A6FFFFFF</Color>
    <Color x:Key="ColorAccentPrimary">#FF0091B3</Color>
    <Color x:Key="ColorAccentSecondary">#FF7A2FD1</Color>
    <Color x:Key="ColorWarning">#FFC97A00</Color>
    <Color x:Key="ColorTextPrimary">#FF10151F</Color>
    <Color x:Key="ColorTextSecondary">#FF54616F</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBackgroundBase" Color="{StaticResource ColorBackgroundBase}" />
    <SolidColorBrush x:Key="BrushPanelSurface" Color="{StaticResource ColorPanelSurface}" />
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />

    <!-- Typography Tokens -->
    <FontFamily x:Key="FontFamilyNumeric">Cascadia Code, JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontFamilyUI">Segoe UI Variable, Inter, Segoe UI</FontFamily>

</ResourceDictionary>
