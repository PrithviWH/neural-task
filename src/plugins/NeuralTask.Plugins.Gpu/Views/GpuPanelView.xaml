<UserControl x:Class="NeuralTask.Plugins.Gpu.Views.GpuPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NeuralTask.Plugins.Gpu"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:GpuPanelViewModel}"
             d:DesignHeight="650" d:DesignWidth="900"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Fallback brushes if host dynamic resources are absent -->
        <SolidColorBrush x:Key="GpuBrushPanel" Color="#181B22" />
        <SolidColorBrush x:Key="GpuBrushBorder" Color="#262A34" />
        <SolidColorBrush x:Key="GpuBrushAccent" Color="#5B61F1" />
        <SolidColorBrush x:Key="GpuBrushSecondary" Color="#11A69C" />
        <SolidColorBrush x:Key="GpuBrushTextPrimary" Color="#F2F4F8" />
        <SolidColorBrush x:Key="GpuBrushTextSecondary" Color="#949AA8" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,28">
        <StackPanel Orientation="Vertical">
            <!-- 1. Header Bar -->
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,14"
                    Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon -->
                        <Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 7,7 L 17,7 L 17,17 L 7,17 Z M 2,9 L 4,9 M 2,15 L 4,15 M 20,9 L 22,9 M 20,15 L 22,15 M 9,2 L 9,4 M 15,2 L 15,4 M 9,20 L 9,22 M 15,20 L 15,22"
                              Stroke="{DynamicResource BrushAccentPrimary}"
                              StrokeThickness="1.5"
                              Width="22" Height="22"
                              Stretch="Uniform"
                              Margin="0,0,14,0" />
                        <StackPanel>
                            <TextBlock Text="GPU telemetry"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding AdapterName, FallbackValue='Detecting GPU...'}"
                                       FontSize="11.5"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextTertiary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Pip -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource BrushAccentPrimarySoft}"
                            BorderBrush="{DynamicResource BrushAccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource BrushAccentPrimary}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Direct3D 12 active"
                                       FontSize="10.5"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushAccentPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Primary Metrics Cards Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: 3D Engine Utilization & Sparkline -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="3D engine utilization"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding UtilizationPercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushAccentPrimary}" />
                        </Grid>

                        <!-- Sparkline Graph -->
                        <Border Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="75"
                                Padding="4"
                                Margin="0,0,0,10">
                            <Path Data="{Binding SparklineGeometry}"
                                  Stroke="{DynamicResource BrushAccentPrimary}"
                                  StrokeThickness="1.75"
                                  Stretch="Fill"
                                  Height="65"
                                  VerticalAlignment="Center" />
                        </Border>

                        <Grid>
                            <TextBlock Text="Utilization (last 40s)"
                                       FontSize="10"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextTertiary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="Real-time kernel tick"
                                       FontSize="10"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextTertiary}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: Dedicated Video Memory (VRAM) -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Dedicated video memory (VRAM)"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding DedicatedMemoryPercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushAccentSecondary}" />
                        </Grid>

                        <!-- VRAM Usage Bar -->
                        <Border Background="{DynamicResource BrushSurfaceRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="8"
                                Margin="0,4,0,12"
                                ClipToBounds="True">
                            <ProgressBar Value="{Binding DedicatedMemoryPercent, Mode=OneWay, FallbackValue=0}"
                                         Minimum="0" Maximum="100"
                                         Height="8"
                                         Foreground="{DynamicResource BrushAccentSecondary}"
                                         Background="Transparent"
                                         BorderThickness="0" />
                        </Border>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Used dedicated VRAM:"
                                       FontSize="11"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding DedicatedMemoryUsedMb, StringFormat='{}{0:N0} MB', FallbackValue='0 MB'}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Total installed VRAM:"
                                       FontSize="11"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding DedicatedMemoryTotalMb, StringFormat='{}{0:N0} MB', FallbackValue='4,096 MB'}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Shared system memory:"
                                       FontSize="11"
                                       FontFamily="{DynamicResource FontFamilyUI}"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock HorizontalAlignment="Right"
                                       Text="{Binding SharedMemoryUsedMb, StringFormat='{}{0:N0} MB', FallbackValue='0 MB'}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       FontFamily="{DynamicResource FontFamilyNumeric}"
                                       Foreground="{DynamicResource BrushTextPrimary}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. GPU Engine Breakdown Section -->
            <Border Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.04" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="DirectX engine subsystems"
                               FontSize="13"
                               FontWeight="SemiBold"
                               FontFamily="{DynamicResource FontFamilyUI}"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               Margin="0,0,0,14" />

                    <!-- 3D Graphics Engine -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3D Rasterization"
                                   FontSize="11.5"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding Engine3DPercent, Mode=OneWay, FallbackValue=0}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushSurfaceRaised}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Engine3DPercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Video Decode Engine -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Video Decode (NVDEC/VCN)"
                                   FontSize="11.5"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding EngineVideoDecodePercent, Mode=OneWay, FallbackValue=0}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource BrushAccentSecondary}"
                                     Background="{DynamicResource BrushSurfaceRaised}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EngineVideoDecodePercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentSecondary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Compute Engine -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Compute / Shader"
                                   FontSize="11.5"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding EngineComputePercent, Mode=OneWay, FallbackValue=0}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource BrushAccentPrimary}"
                                     Background="{DynamicResource BrushSurfaceRaised}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EngineComputePercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushAccentPrimary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- DMA / Copy Engine -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DMA / Blit / Copy"
                                   FontSize="11.5"
                                   FontFamily="{DynamicResource FontFamilyUI}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Value="{Binding EngineCopyPercent, Mode=OneWay, FallbackValue=0}"
                                     Minimum="0" Maximum="100"
                                     Height="6"
                                     Foreground="{DynamicResource BrushTextTertiary}"
                                     Background="{DynamicResource BrushSurfaceRaised}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding EngineCopyPercent, StringFormat='{}{0:F1}%', FallbackValue='0.0%'}"
                                   FontSize="11"
                                   FontFamily="{DynamicResource FontFamilyNumeric}"
                                   Foreground="{DynamicResource BrushTextTertiary}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
